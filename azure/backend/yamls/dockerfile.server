# Use official Node.js image
FROM node:20-slim

# Create and set working directory
WORKDIR /app

# Copy package.json and install dependencies first (better layer caching)
COPY package*.json ./
RUN npm install --production

# Copy all remaining code into the container
COPY . .

# Expose port (even if it's dynamic in your code, still useful for mapping)
EXPOSE 8000

# Run the Node.js server
CMD ["node", "server.js"]
